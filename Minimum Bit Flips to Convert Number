class Solution {
    public int minBitFlips(int start, int goal) {
        int flip=0;
        while(start>0||goal>0){
            int bitA=start&1;
            int bitB=goal&1;
            
            if(bitA!=bitB){
                
           
                flip+=1;
            }
            start=start>>1;
            goal=goal>>1;
        }return flip;
        
    }
}
