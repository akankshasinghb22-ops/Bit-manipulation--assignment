class Solution {
    public int countPrimeSetBits(int left, int right) {
        int primeCount = 0;
        
        for (int i = left; i <= right; i++) {
            int setBits = countSetBits(i);
            
            if (isPrime(setBits)) {
                primeCount++;
            }
        }
        
        return primeCount;
    }
    
    // Custom bit-counting function (Brian Kernighan's Algorithm)
    private int countSetBits(int n) {
        int count = 0;
        while (n > 0) {
            count++;
            n &= (n - 1); // Clears the rightmost set bit (1) in each iteration
        }
        return count;
    }
    
    // Custom prime check for numbers up to 20
    private boolean isPrime(int n) {
        if (n < 2) {
            return false;
        }
        return (n == 2 || n == 3 || n == 5 || n == 7 || 
                n == 11 || n == 13 || n == 17 || n == 19);
    }
}
